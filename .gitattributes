# Normalise text to LF in the repo; Godot and gdtoolkit expect LF.
* text=auto eol=lf

# Binary assets: never diff or merge as text.
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.exr binary
*.hdr binary
*.glb binary
*.blend binary
*.wav binary
*.ogg binary
*.mp3 binary
*.ttf binary
*.otf binary
*.res binary
*.scn binary

# Git LFS (PLAN §3.7). Not enabled yet: git-lfs is not installed on the main dev
# machine, and turning these on without it commits raw blobs that LFS clones then
# report as broken. Install git-lfs (`git lfs install`), then replace the matching
# lines above with these and run `git add --renormalize .`:
# *.png filter=lfs diff=lfs merge=lfs -text
# *.glb filter=lfs diff=lfs merge=lfs -text
# *.blend filter=lfs diff=lfs merge=lfs -text
# *.wav filter=lfs diff=lfs merge=lfs -text
# *.ogg filter=lfs diff=lfs merge=lfs -text
# *.exr filter=lfs diff=lfs merge=lfs -text
