[gd_resource type="Resource" script_class="AmbienceSet" format=3]

[ext_resource type="Script" path="res://audio/ambience_set.gd" id="1_set"]
[ext_resource type="Script" path="res://audio/ambience_bed.gd" id="2_bed"]
[ext_resource type="Script" path="res://audio/ambience_detail.gd" id="3_detail"]

[sub_resource type="Resource" id="Bed_amb_emberfall_rumble"]
script = ExtResource("2_bed")
event = &"amb_emberfall_rumble"
wander_db = Vector2(-4, 0)

[sub_resource type="Resource" id="Bed_amb_emberfall_lava"]
script = ExtResource("2_bed")
event = &"amb_emberfall_lava"
wander_db = Vector2(-7, -1)

[sub_resource type="Resource" id="Bed_amb_emberfall_wind"]
script = ExtResource("2_bed")
event = &"amb_emberfall_wind"
wander_db = Vector2(-6, 0)

[sub_resource type="Resource" id="Bed_amb_kessel_hush"]
script = ExtResource("2_bed")
event = &"amb_kessel_hush"
hush = true

[sub_resource type="Resource" id="Detail_amb_rock_crack"]
script = ExtResource("3_detail")
event = &"amb_rock_crack"
weight = 0.6

[sub_resource type="Resource" id="Detail_amb_ember_tick"]
script = ExtResource("3_detail")
event = &"amb_ember_tick"
weight = 0.45

[sub_resource type="Resource" id="Detail_amb_gas_hiss"]
script = ExtResource("3_detail")
event = &"amb_gas_hiss"
weight = 0.1
vent = 1.4
anchor = &"vent"

[sub_resource type="Resource" id="Detail_amb_distant_collapse"]
script = ExtResource("3_detail")
event = &"amb_distant_collapse"
weight = 0.15

[sub_resource type="Resource" id="Detail_amb_flux_vent"]
script = ExtResource("3_detail")
event = &"amb_flux_vent"
weight = 0
vent = 1.0
anchor = &"vent"

[sub_resource type="Resource" id="Detail_amb_combine_industry"]
script = ExtResource("3_detail")
event = &"amb_combine_industry"
weight = 0
base = 2.6
anchor = &"base"

[resource]
script = ExtResource("1_set")
id = &"emberfall"
beds = Array[ExtResource("2_bed")]([SubResource("Bed_amb_emberfall_rumble"), SubResource("Bed_amb_emberfall_lava"), SubResource("Bed_amb_emberfall_wind"), SubResource("Bed_amb_kessel_hush")])
details = Array[ExtResource("3_detail")]([SubResource("Detail_amb_rock_crack"), SubResource("Detail_amb_ember_tick"), SubResource("Detail_amb_gas_hiss"), SubResource("Detail_amb_distant_collapse"), SubResource("Detail_amb_flux_vent"), SubResource("Detail_amb_combine_industry")])
