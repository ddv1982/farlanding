[gd_resource type="Resource" script_class="AmbienceSet" format=3]

[ext_resource type="Script" path="res://audio/ambience_set.gd" id="1_set"]
[ext_resource type="Script" path="res://audio/ambience_bed.gd" id="2_bed"]
[ext_resource type="Script" path="res://audio/ambience_detail.gd" id="3_detail"]

[sub_resource type="Resource" id="Bed_amb_thalassa_wind"]
script = ExtResource("2_bed")
event = &"amb_thalassa_wind"
wander_db = Vector2(-5, 0)
tide_db = Vector2(0, -1.5)

[sub_resource type="Resource" id="Bed_amb_thalassa_surf"]
script = ExtResource("2_bed")
event = &"amb_thalassa_surf"
wander_db = Vector2(-8, -1)
tide_db = Vector2(-3, 1)

[sub_resource type="Resource" id="Bed_amb_thalassa_drone"]
script = ExtResource("2_bed")
event = &"amb_thalassa_drone"
wander_db = Vector2(-6, -2)
tide_db = Vector2(-1, 2)

[sub_resource type="Resource" id="Bed_amb_kessel_hush"]
script = ExtResource("2_bed")
event = &"amb_kessel_hush"
hush = true

[sub_resource type="Resource" id="Detail_amb_water_lap"]
script = ExtResource("3_detail")
event = &"amb_water_lap"
weight = 0.45
flood = 1.1

[sub_resource type="Resource" id="Detail_amb_shell_click"]
script = ExtResource("3_detail")
event = &"amb_shell_click"
weight = 0.15
ebb = 0.85

[sub_resource type="Resource" id="Detail_amb_shore_call"]
script = ExtResource("3_detail")
event = &"amb_shore_call"
weight = 0.3
storm_cover = 1

[sub_resource type="Resource" id="Detail_amb_drip"]
script = ExtResource("3_detail")
event = &"amb_drip"
weight = 0.2
ebb = 0.45

[sub_resource type="Resource" id="Detail_amb_buoy_bell"]
script = ExtResource("3_detail")
event = &"amb_buoy_bell"
weight = 0.25
flood = 0.15

[sub_resource type="Resource" id="Detail_amb_flux_vent"]
script = ExtResource("3_detail")
event = &"amb_flux_vent"
weight = 0
vent = 1.6
anchor = &"vent"

[sub_resource type="Resource" id="Detail_amb_combine_industry"]
script = ExtResource("3_detail")
event = &"amb_combine_industry"
weight = 0
base = 2.6
anchor = &"base"

[resource]
script = ExtResource("1_set")
id = &"thalassa_low"
beds = Array[ExtResource("2_bed")]([SubResource("Bed_amb_thalassa_wind"), SubResource("Bed_amb_thalassa_surf"), SubResource("Bed_amb_thalassa_drone"), SubResource("Bed_amb_kessel_hush")])
details = Array[ExtResource("3_detail")]([SubResource("Detail_amb_water_lap"), SubResource("Detail_amb_shell_click"), SubResource("Detail_amb_shore_call"), SubResource("Detail_amb_drip"), SubResource("Detail_amb_buoy_bell"), SubResource("Detail_amb_flux_vent"), SubResource("Detail_amb_combine_industry")])
