[sub_resource type="Resource" id="Resource_explore_clip"]
script = ExtResource("2_clip")
name = &"explore"
layers = Array[AudioStream]([ExtResource("4_pad"), ExtResource("5_pulse"), ExtResource("6_melody"), ExtResource("7_drive"), ExtResource("8_drums"), ExtResource("9_brass"), ExtResource("10_trail"), ExtResource("11_hush"), ExtResource("12_watch"), ExtResource("13_storm")])
layer_names = PackedStringArray("pad", "pulse", "melody", "drive", "drums", "brass", "trail", "hush", "watch", "storm")

[sub_resource type="Resource" id="Resource_explore"]
