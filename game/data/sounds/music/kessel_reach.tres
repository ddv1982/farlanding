[gd_resource type="Resource" script_class="MusicScore" format=3]

[ext_resource type="Script" path="res://audio/music_score.gd" id="1_score"]
[ext_resource type="Script" path="res://audio/music_clip.gd" id="2_clip"]
[ext_resource type="Script" path="res://audio/music_state.gd" id="3_state"]
[ext_resource type="AudioStream" path="res://assets/audio/music/kessel/mus_kessel_explore_pad.ogg" id="4_pad"]
[ext_resource type="AudioStream" path="res://assets/audio/music/kessel/mus_kessel_explore_pulse.ogg" id="5_pulse"]
[ext_resource type="AudioStream" path="res://assets/audio/music/kessel/mus_kessel_explore_melody.ogg" id="6_melody"]
[ext_resource type="AudioStream" path="res://assets/audio/music/kessel/mus_kessel_tension_drive.ogg" id="7_drive"]
[ext_resource type="AudioStream" path="res://assets/audio/music/kessel/mus_kessel_combat_drums.ogg" id="8_drums"]
[ext_resource type="AudioStream" path="res://assets/audio/music/kessel/mus_kessel_combat_brass.ogg" id="9_brass"]
[ext_resource type="AudioStream" path="res://assets/audio/music/kessel/mus_kessel_explore_trail.ogg" id="10_trail"]

[sub_resource type="Resource" id="Resource_explore_clip"]
script = ExtResource("2_clip")
name = &"explore"
layers = Array[AudioStream]([ExtResource("4_pad"), ExtResource("5_pulse"), ExtResource("6_melody"), ExtResource("7_drive"), ExtResource("8_drums"), ExtResource("9_brass"), ExtResource("10_trail")])
layer_names = PackedStringArray("pad", "pulse", "melody", "drive", "drums", "brass", "trail")

[sub_resource type="Resource" id="Resource_explore"]
script = ExtResource("3_state")
name = &"explore"
clip = &"explore"
layer_volumes_db = PackedFloat32Array(0, 0, 0, -80, -80, -80, 0)
intensity = 0

[sub_resource type="Resource" id="Resource_calm"]
script = ExtResource("3_state")
name = &"calm"
clip = &"explore"
layer_volumes_db = PackedFloat32Array(0, -80, -6, -80, -80, -80, -3)
intensity = 0

[sub_resource type="Resource" id="Resource_tension"]
script = ExtResource("3_state")
name = &"tension"
clip = &"explore"
layer_volumes_db = PackedFloat32Array(-2, -6, -80, 0, -80, -80, -8)
intensity = 1

[sub_resource type="Resource" id="Resource_combat"]
script = ExtResource("3_state")
name = &"combat"
clip = &"explore"
layer_volumes_db = PackedFloat32Array(-4, -80, -80, -3, 0, 0, -80)
intensity = 2

[sub_resource type="Resource" id="Resource_aftermath"]
script = ExtResource("3_state")
name = &"aftermath"
clip = &"explore"
layer_volumes_db = PackedFloat32Array(0, -80, -5, -14, -80, -80, -4)
intensity = 1

[sub_resource type="Resource" id="Resource_victory"]
script = ExtResource("3_state")
name = &"victory"
clip = &"explore"
layer_volumes_db = PackedFloat32Array(-6, -80, -10, -80, -80, -80, -6)
intensity = 3

[sub_resource type="Resource" id="Resource_defeat"]
script = ExtResource("3_state")
name = &"defeat"
clip = &"explore"
layer_volumes_db = PackedFloat32Array(-10, -80, -80, -20, -80, -80, -80)
intensity = 3

[resource]
script = ExtResource("1_score")
id = &"kessel_reach"
clips = Array[ExtResource("2_clip")]([SubResource("Resource_explore_clip")])
states = Array[ExtResource("3_state")]([SubResource("Resource_explore"), SubResource("Resource_calm"), SubResource("Resource_tension"), SubResource("Resource_combat"), SubResource("Resource_aftermath"), SubResource("Resource_victory"), SubResource("Resource_defeat")])
default_state = &"explore"
transition_beats = 4.0
min_hold = 8.0
layer_fade = 3.0
ambience = &"amb_kessel_wind"
