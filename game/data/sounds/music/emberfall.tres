[resource]
script = ExtResource("1_score")
id = &"emberfall"
clips = Array[ExtResource("2_clip")]([SubResource("Resource_explore_clip")])
states = Array[ExtResource("3_state")]([SubResource("Resource_explore"), SubResource("Resource_calm"), SubResource("Resource_tension"), SubResource("Resource_combat"), SubResource("Resource_combat_heavy"), SubResource("Resource_aftermath"), SubResource("Resource_victory"), SubResource("Resource_defeat"), SubResource("Resource_stealth_unaware"), SubResource("Resource_stealth_suspicious"), SubResource("Resource_stealth_alerted")])
default_state = &"explore"
transition_beats = 4.0
min_hold = 8.0
layer_fade = 3.0
bpm = 56.0
quantize_beats = 1.0
ambience = &"amb_emberfall_rumble"
