[sub_resource type="Resource" id="Resource_explore_clip"]
script = ExtResource("2_clip")
name = &"explore"
layers = Array[AudioStream]([ExtResource("4_pad"), ExtResource("5_pulse"), ExtResource("6_melody"), ExtResource("7_drive"), ExtResource("8_drums"), ExtResource("9_brass"), ExtResource("10_trail"), ExtResource("11_hush"), ExtResource("12_watch"), ExtResource("13_melody_b"), ExtResource("14_melody_c"), ExtResource("15_pulse_b"), ExtResource("16_drums_b"), ExtResource("17_urgency"), ExtResource("18_heavy"), ExtResource("19_pressure"), ExtResource("20_holdout")])
layer_names = PackedStringArray("pad", "pulse", "melody", "drive", "drums", "brass", "trail", "hush", "watch", "melody_b", "melody_c", "pulse_b", "drums_b", "urgency", "heavy", "pressure", "holdout")
layer_groups = PackedStringArray("", "pulse", "melody", "", "drums", "", "", "", "", "melody", "melody", "pulse", "drums", "", "", "", "")
loop_beats = 64

