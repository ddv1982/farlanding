[resource]
script = ExtResource("e0")
id = &"emberfall_conquest"
title = "Caldera Conquest"
mission_type = &"conquest"
summary = "Emberfall's caldera holds the richest Flux on the trail, and it erupts. The Combine holds the far shelf and already siphons the caldera."
briefing = "Emberfall, the next world along the trail: black basalt, rivers of lava, and a caldera in the middle whose Flux vents are the richest we have seen. The Combine holds the far ash shelf and already has a Siphon on the caldera.

Rich vents fill with pressure while a Flux Tap draws on them and erupt when full, hitting everything nearby hard and knocking the Tap out; select the Tap and press VENT before it peaks to release the pressure on purpose, at a small cost. The gauge top right shows the vent closest to bursting, and a seismic fissure west of the caldera can tell you which one goes next.

Lava is never crossable: three rock bridges and the caldera's ramps are the only ways across. Build up on your shelf, take the caldera's Flux if you dare, and take their base apart. The trail continues here, in a furnace north of the western bridge."
map_scene = ExtResource("e5")
planet = ExtResource("planet")
player_hq = ExtResource("e2")
player_start = Vector3(-80, 0, 84)
player_roster = Array[ExtResource("e9")]([ExtResource("e6"), ExtResource("e6"), ExtResource("e7"), ExtResource("e8")])
start_alloy = 450
hostile_faction = 1
hostile_hq = ExtResource("e10")
hostile_hq_position = Vector3(82, 0, -84)
hostile_buildings = Array[ExtResource("e13")]([ExtResource("e11"), ExtResource("e12"), ExtResource("e19"), ExtResource("e19")])
hostile_building_positions = PackedVector3Array(62, 0, -82, 74, 0, -62, 100, 0, -100, 12, 0, -12)
hostile_roster = Array[ExtResource("e9")]([ExtResource("e14"), ExtResource("e14"), ExtResource("e15"), ExtResource("e16"), ExtResource("e16"), ExtResource("e16"), ExtResource("e17")])
hostile_start = Vector3(92, 0, -66)
commander_profile = ExtResource("e18")
enemy_difficulty = "normal"
objectives = Array[ExtResource("e1")]([SubResource("s0"), SubResource("s1"), SubResource("s2"), SubResource("s4"), SubResource("s3")])
