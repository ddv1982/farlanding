[resource]
script = ExtResource("e0")
id = &"thalassa_recovery"
title = "Low-Water Recovery"
mission_type = &"recovery"
summary = "An Antecedent artefact lies on the northern shoal across the channel. Bring it back to the Lander before the Combine takes it home."
briefing = "The vault the trail led to has given up its core: an Antecedent artefact, lying in its cradle on the north-west shoal across the channel. The Combine has seen it too and will send a squad for it.

Send a unit to pick it up (select units and right-click the artefact). The carrier moves slowly and cannot fight, so escort it; if it falls, anyone of yours can pick the artefact up again. If the Combine carries it into their base, the mission is lost.

Mind the tide: the fords are the short way across, but when the sea rises they flood, and anyone wading takes damage. The causeway in the middle stays dry; the Kites hover over flooded shallows."
map_scene = ExtResource("e5")
planet = ExtResource("planet")
player_hq = ExtResource("e2")
player_start = Vector3(-80, 0, 86)
player_roster = Array[ExtResource("e9")]([ExtResource("e6"), ExtResource("e7"), ExtResource("e19"), ExtResource("e19"), ExtResource("e19"), ExtResource("e19"), ExtResource("e20"), ExtResource("e20")])
start_alloy = 400
hostile_faction = 1
hostile_hq = ExtResource("e10")
hostile_hq_position = Vector3(84, 0, -88)
hostile_buildings = Array[ExtResource("e13")]([ExtResource("e11"), ExtResource("e12")])
hostile_building_positions = PackedVector3Array(64, 0, -86, 74, 0, -66)
hostile_roster = Array[ExtResource("e9")]([ExtResource("e14"), ExtResource("e14"), ExtResource("e15"), ExtResource("e16"), ExtResource("e16"), ExtResource("e16"), ExtResource("e17")])
hostile_start = Vector3(94, 0, -68)
commander_profile = ExtResource("e18")
enemy_difficulty = "normal"
objectives = Array[ExtResource("e1")]([SubResource("s0"), SubResource("s1"), SubResource("s5"), SubResource("s2"), SubResource("s3")])
props = ExtResource("e22")
