[resource]
script = ExtResource("e0")
id = &"verdance_infiltration"
title = "Under the Crowns"
mission_type = &"infiltration"
summary = "No base. Take a survey team from grove to grove to the Combine's side of the basin while Hornets hunt the open lanes."
briefing = "The Combine has strung a listening post under a grove by its outpost and logs every crown in the basin. We want that log, and the moths roosting in the hollow trunk east of the centre, whose eyes see in the dark under the trees.

You have two Surveyors and three Rangers, no base and no reinforcements. Hornets fly patrols over the open lanes and the outpost: in the open they see you from far off, but under a crown nobody sees you unless they come within a few metres on foot, or you fire. Go from grove to grove, scan both sites (the moths east of the centre grove, the post in the grove north of the outpost), then bring the team home to the landing.

If they raise the alarm, more Hornets come hunting, the pick-up moves to the far west and the clock starts. Firing from under a crown gives you away for a few seconds."
map_scene = ExtResource("e9")
planet = ExtResource("planet")
player_start = Vector3(-80, 0, 85)
player_facing = Vector3(1, 0, -1)
player_roster = Array[ExtResource("e5")]([ExtResource("e11"), ExtResource("e11"), ExtResource("e10"), ExtResource("e10"), ExtResource("e10")])
start_alloy = 0
start_flux = 0
hostile_faction = 1
hostile_hq = ExtResource("e7")
hostile_hq_position = Vector3(82, 0, -84)
hostile_buildings = Array[ExtResource("e14")]([ExtResource("e12"), ExtResource("e13")])
hostile_building_positions = PackedVector3Array(64, 0, -66, 62, 0, -84)
patrols = Array[ExtResource("e2")]([SubResource("s0"), SubResource("s1"), SubResource("s2"), SubResource("s3"), SubResource("s4")])
enemy_alert_meter = true
objectives = Array[ExtResource("e4")]([SubResource("s7"), SubResource("s5"), SubResource("s8"), SubResource("s9"), SubResource("s10")])
mission_script = ExtResource("e15")
script_rules = SubResource("s6")
camera_start = Vector3(-80, 0, 85)
