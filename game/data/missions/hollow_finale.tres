enemy_objective = &"rival_core"

[resource]
script = ExtResource("e0")
id = &"hollow_finale"
title = "The Beacon Core"
mission_type = &"finale"
summary = "The end of the Trail. Wake the Beacon Core on the dais before the Combine does, while every guardian on the deck comes for it."
briefing = "This is what the beacons pointed to. The Beacon Core stands on the dais at the centre of the deck, dormant, and it draws on the engines around it.

To wake it, run at least four engines and keep a Surveyor linked beside it on the dais. The Core charges while both hold, faster with every engine beyond four. If the Combine links at the same time, the dais is contested and nobody charges.

The Custodians will not let it happen quietly. As the charge rises they wake in stages, the nearest first, and converge on the dais. By the end, every guardian on the deck is coming.

The Combine wants the Core too. It will take engines, send its own linker to the dais and strike at yours. If it wakes the Core first, or the Lander falls, the Trail is lost."
map_scene = ExtResource("e5")
planet = ExtResource("planet")
player_hq = ExtResource("e2")
player_start = Vector3(-80, 0, 85)
player_roster = Array[ExtResource("e9")]([ExtResource("e6"), ExtResource("e6"), ExtResource("e7"), ExtResource("e7"), ExtResource("e8"), ExtResource("e8"), ExtResource("e20"), ExtResource("e20"), ExtResource("e20"), ExtResource("e20")])
start_alloy = 650
hostile_faction = 1
hostile_hq = ExtResource("e10")
hostile_hq_position = Vector3(84, 0, -86)
hostile_buildings = Array[ExtResource("e13")]([ExtResource("e11"), ExtResource("e12"), ExtResource("e12")])
hostile_building_positions = PackedVector3Array(66, 0, -88, 76, 0, -66, 98, 0, -74)
hostile_roster = Array[ExtResource("e9")]([ExtResource("e14"), ExtResource("e14"), ExtResource("e15"), ExtResource("e15"), ExtResource("e16"), ExtResource("e16"), ExtResource("e17"), ExtResource("e24"), ExtResource("e19")])
hostile_start = Vector3(72, 0, -74)
commander_profile = ExtResource("e18")
enemy_difficulty = "normal"
objectives = Array[ExtResource("e1")]([SubResource("wake"), SubResource("rival"), SubResource("keep"), SubResource("annal"), SubResource("sent")])
mission_script = ExtResource("e22")
script_rules = SubResource("rules")
