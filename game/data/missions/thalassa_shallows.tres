[resource]
script = ExtResource("e0")
id = &"thalassa_shallows"
title = "Tidewater Landing"
mission_type = &"conquest"
summary = "Placeholder landing on Thalassa Low: a dug-in Combine base and the trail's next marker."
briefing = "Thalassa Low, the next world along the trail. The Combine got here first and holds a full base on the far side of the flats; their commander is sharper than the one on Kessel.

Put the Lander down, build up and take their base apart. The trail continues here: a beacon and a ruin, if a Surveyor can reach them. Anything the Meridian learned on Kessel lands with you.

(Placeholder landing: Thalassa's own map and tide arrive in Phase 8; this plays on the Kessel map.)"
map_scene = ExtResource("e5")
planet = ExtResource("planet")
player_hq = ExtResource("e2")
start_alloy = 450
player_start = Vector3(-80, 0, 85)
player_roster = Array[ExtResource("e9")]([ExtResource("e6"), ExtResource("e6"), ExtResource("e7"), ExtResource("e8")])
hostile_faction = 1
hostile_hq = ExtResource("e10")
hostile_hq_position = Vector3(66, 0, -95)
hostile_buildings = Array[ExtResource("e13")]([ExtResource("e11"), ExtResource("e12")])
hostile_building_positions = PackedVector3Array(47, 0, -92, 54, 0, -79)
hostile_roster = Array[ExtResource("e9")]([ExtResource("e14"), ExtResource("e14"), ExtResource("e15"), ExtResource("e16"), ExtResource("e16"), ExtResource("e16"), ExtResource("e17")])
hostile_start = Vector3(56, 0, -84)
commander_profile = ExtResource("e18")
enemy_difficulty = "normal"
objectives = Array[ExtResource("e1")]([SubResource("s0"), SubResource("s1"), SubResource("s2"), SubResource("s3")])
