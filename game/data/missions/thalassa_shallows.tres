[resource]
script = ExtResource("e0")
id = &"thalassa_shallows"
title = "Tidewater Landing"
mission_type = &"conquest"
summary = "Tidal flats on Thalassa Low: the Combine holds the far shoal, and the tide decides which way across is open."
briefing = "Thalassa Low, the next world along the trail. The Combine got here first and holds a full base on the far shoal; their commander is sharper than the one on Kessel.

The tide here is the rule: when it rises it floods the fords and the tidal pans, and ground units caught in them wade slowly and take damage. Only the causeway in the middle crosses the deep channel at every tide; skimmers like the Kite hover over flooded shallows, never over the channel.

Build up on your shoal, mine the pans while they are dry, and take their base apart. The trail continues here: a drowned beacon south of the channel bears on something across it."
map_scene = ExtResource("e5")
planet = ExtResource("planet")
player_hq = ExtResource("e2")
player_start = Vector3(-80, 0, 86)
player_roster = Array[ExtResource("e9")]([ExtResource("e6"), ExtResource("e6"), ExtResource("e7"), ExtResource("e8")])
start_alloy = 450
hostile_faction = 1
hostile_hq = ExtResource("e10")
hostile_hq_position = Vector3(84, 0, -88)
hostile_buildings = Array[ExtResource("e13")]([ExtResource("e11"), ExtResource("e12")])
hostile_building_positions = PackedVector3Array(64, 0, -86, 74, 0, -66)
hostile_roster = Array[ExtResource("e9")]([ExtResource("e14"), ExtResource("e14"), ExtResource("e15"), ExtResource("e16"), ExtResource("e16"), ExtResource("e16"), ExtResource("e17")])
hostile_start = Vector3(94, 0, -68)
commander_profile = ExtResource("e18")
enemy_difficulty = "normal"
objectives = Array[ExtResource("e1")]([SubResource("s0"), SubResource("s1"), SubResource("s2"), SubResource("s4"), SubResource("s3")])
