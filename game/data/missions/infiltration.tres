[resource]
script = ExtResource("e0")
id = &"infiltration"
title = "Quiet Uplink"
mission_type = &"infiltration"
summary = "No base. Slip a Wisp squad past the outpost's patrols and sabotage its uplink."
briefing = "The Combine outpost in the north-east relays everything it finds to their fleet. We want it deaf, and we do not want them to know who did it.\n\nYou have three Wisps and a Surveyor, dropped at the far side of the basin. No base, no reinforcements. In stealth mode Wisps creep and cloak; guards only notice them close up and inside their sight cones, and not at once. Sabotage the uplink (the outpost's Hub), then get the squad out.\n\nIf they raise the alarm the job is not over, but it changes: more drones arrive, the pick-up moves to the far west and the clock starts."
map_scene = ExtResource("e9")
planet = ExtResource("planet")
player_start = Vector3(-78, 0, 80)
player_facing = Vector3(1, 0, -1)
player_roster = Array[ExtResource("e5")]([ExtResource("e10"), ExtResource("e10"), ExtResource("e10"), ExtResource("e11")])
start_alloy = 0
start_flux = 0
hostile_faction = 1
hostile_hq = ExtResource("e7")
hostile_hq_position = Vector3(66, 0, -95)
hostile_buildings = Array[ExtResource("e14")]([ExtResource("e12"), ExtResource("e13")])
hostile_building_positions = PackedVector3Array(54, 0, -79, 47, 0, -92)
patrols = Array[ExtResource("e2")]([SubResource("s0"), SubResource("s1"), SubResource("s2"), SubResource("s3"), SubResource("s4")])
enemy_alert_meter = true
objectives = Array[ExtResource("e4")]([SubResource("s7"), SubResource("s5"), SubResource("s8"), SubResource("s9"), SubResource("s10")])
mission_script = ExtResource("e15")
script_rules = SubResource("s6")
camera_start = Vector3(-78, 0, 80)
props = ExtResource("outpost")
