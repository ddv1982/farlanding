[sub_resource type="Resource" id="hold"]
script = ExtResource("e1")
id = &"hold_engines"
title = "Run four engines for three minutes"
kind = &"primary"
type = &"hold_machines"
side = &"player"
amount = 4
seconds = 180.0

[sub_resource type="Resource" id="rival"]
script = ExtResource("e1")
id = &"rival_engines"
title = "Keep the Combine from holding four for four minutes"
kind = &"primary"
type = &"hold_machines"
side = &"enemy"
passive = true
amount = 4
seconds = 240.0

