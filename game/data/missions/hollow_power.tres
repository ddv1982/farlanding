[resource]
script = ExtResource("e0")
id = &"hollow_power"
title = "Power Up"
mission_type = &"power"
summary = "Hollow Meridian is a built world, and its power is still in its engines. Wake them, hold them, and keep the Combine from holding more."
briefing = "The trail ends at Hollow Meridian: not a planet but a structure, plated decks over nothing, cut by two chasms with no floor. Four bridges cross them. At the centre, on a dais, stands the Beacon Core every beacon pointed to.

There are no Reactors here. Power comes from the Antecedent engines standing on the deck. Send a Fabricator or a Surveyor to one and it wakes after a while; from then on it powers whoever runs it. The Combine can take a running engine over the same way, or shoot it until it shuts down for a while. It never breaks for good.

Every engine has guardians. Waking one stirs the Custodians around it, and they go for whoever woke them: Wardens up close, and Sentinels, heavier, that strike from range and hit flyers too. The engines near the Lander are lightly watched. The ones across the bridges are not.

Run four engines for three minutes in all. If the Combine holds four for four minutes first, the deck is theirs."
map_scene = ExtResource("e5")
planet = ExtResource("planet")
player_hq = ExtResource("e2")
player_start = Vector3(-80, 0, 85)
player_roster = Array[ExtResource("e9")]([ExtResource("e6"), ExtResource("e6"), ExtResource("e7"), ExtResource("e8"), ExtResource("e20"), ExtResource("e20"), ExtResource("e20")])
start_alloy = 500
hostile_faction = 1
hostile_hq = ExtResource("e10")
hostile_hq_position = Vector3(84, 0, -86)
hostile_buildings = Array[ExtResource("e13")]([ExtResource("e11"), ExtResource("e12")])
hostile_building_positions = PackedVector3Array(66, 0, -88, 76, 0, -66)
hostile_roster = Array[ExtResource("e9")]([ExtResource("e14"), ExtResource("e14"), ExtResource("e15"), ExtResource("e15"), ExtResource("e16"), ExtResource("e16"), ExtResource("e17")])
hostile_start = Vector3(72, 0, -74)
commander_profile = ExtResource("e18")
enemy_difficulty = "normal"
objectives = Array[ExtResource("e1")]([SubResource("hold"), SubResource("rival"), SubResource("keep"), SubResource("trail"), SubResource("rig"), SubResource("sent")])
