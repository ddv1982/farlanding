carryovers = Array[ExtResource("e21")]([SubResource("s22"), SubResource("s24"), SubResource("s26"), SubResource("s28")])
locked_at_start = Array[StringName]([&"concord_survey_lab", &"concord_lancer", &"concord_sentry", &"concord_arc"])
lost_landing_share = 0.0
