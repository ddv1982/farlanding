[sub_resource type="Resource" id="s0"]
script = ExtResource("e18")
id = &"escort_none"
title = "Standard crew"
description = "Only the mission's own crew lands."
requires_tech = Array[StringName]([])
effects = Array[ExtResource("e22")]([])

[sub_resource type="Resource" id="s1"]
script = ExtResource("e22")
kind = &"units"
unit = ExtResource("e23")
count = 2

[sub_resource type="Resource" id="s2"]
script = ExtResource("e18")
id = &"escort_rangers"
title = "Ranger pair"
description = "Two Rangers land with the crew."
requires_tech = Array[StringName]([])
effects = Array[ExtResource("e22")]([SubResource("s1")])

[sub_resource type="Resource" id="s3"]
script = ExtResource("e22")
kind = &"units"
unit = ExtResource("e24")
count = 1

[sub_resource type="Resource" id="s4"]
script = ExtResource("e18")
id = &"escort_surveyor"
title = "Second Surveyor"
description = "A second Surveyor lands with the crew: two sites at once."
requires_tech = Array[StringName]([])
effects = Array[ExtResource("e22")]([SubResource("s3")])

[sub_resource type="Resource" id="s5"]
script = ExtResource("e22")
kind = &"units"
unit = ExtResource("e25")
count = 2

[sub_resource type="Resource" id="s6"]
